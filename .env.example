# Server-side only (Vercel Functions in /api). Set these on the Vercel project
# (Upstash Redis from the Vercel Marketplace adds them). Never prefix with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, client: force the order backend. "api" = shared /api, "local" = this browser only.
# Default: use /api when it answers, else localStorage.
# VITE_BACKEND=
